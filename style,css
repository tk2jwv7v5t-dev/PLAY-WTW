/* ============ غُرَف — style.css ============ */
:root {
  --bg: #0d0f14;
  --bg-2: #141821;
  --panel: #1a1f2b;
  --panel-2: #222838;
  --line: #2c3346;
  --text: #eef1f7;
  --muted: #8d96ab;
  --accent: #ff8a3d;
  --accent-2: #ffb36b;
  --accent-ink: #1b0f05;
  --good: #3ddc97;
  --bad: #ff5c6c;
  --radius: 16px;
  --shadow: 0 10px 40px rgba(0, 0, 0, .35);
  --font: "IBM Plex Sans Arabic", system-ui, -apple-system, "Segoe UI", Tahoma, sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: var(--font);
  background:
    radial-gradient(900px 500px at 85% -10%, rgba(255, 138, 61, .14), transparent 60%),
    radial-gradient(700px 400px at -10% 110%, rgba(90, 110, 255, .10), transparent 60%),
    var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: none; }
.hidden { display: none !important; }

/* ---------- عناصر عامة ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 12px 20px; border-radius: 12px;
  background: var(--panel-2); border: 1px solid var(--line);
  font-weight: 600; transition: transform .12s, background .2s, border-color .2s;
  white-space: nowrap;
}
.btn:hover { background: #2a3145; border-color: #3a435c; }
.btn:active { transform: scale(.97); }
.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: var(--accent-ink); border-color: transparent;
}
.btn-primary:hover { filter: brightness(1.06); background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
.btn-danger { background: rgba(255, 92, 108, .14); color: var(--bad); border-color: rgba(255, 92, 108, .35); }
.btn-danger:hover { background: rgba(255, 92, 108, .24); }

.input, .select {
  width: 100%; padding: 12px 14px; border-radius: 12px;
  background: var(--bg-2); border: 1px solid var(--line); outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.input:focus, .select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(255, 138, 61, .18); }
.select { width: auto; padding: 10px 12px; }
.label { display: block; font-size: 14px; color: var(--muted); margin-bottom: 8px; }

/* ---------- اللوبي ---------- */
.lobby { max-width: 1040px; margin: 0 auto; padding: 48px 16px 64px; }
.brand { display: flex; align-items: center; gap: 12px; margin-bottom: 40px; }
.brand-mark {
  width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: var(--accent-ink); font-weight: 800; font-size: 22px;
}
.brand-name { font-size: 24px; font-weight: 800; letter-spacing: -.5px; }

.hero h1 { font-size: clamp(30px, 5vw, 52px); line-height: 1.2; font-weight: 800; margin-bottom: 12px; }
.hero h1 span { color: var(--accent); }
.hero p { color: var(--muted); font-size: 18px; max-width: 560px; margin-bottom: 32px; }

.invite-banner {
  display: flex; align-items: center; gap: 10px;
  background: rgba(255, 138, 61, .12); border: 1px solid rgba(255, 138, 61, .4);
  padding: 14px 18px; border-radius: var(--radius); margin-bottom: 24px;
}

.card {
  background: var(--panel); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow);
}
.name-card { margin-bottom: 32px; max-width: 480px; }

.section-title { font-size: 20px; font-weight: 700; margin-bottom: 16px; }

.rooms-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px; margin-bottom: 36px;
}
.room-card {
  text-align: right; background: var(--panel); border: 1px solid var(--line);
  border-radius: var(--radius); padding: 22px; display: flex; flex-direction: column; gap: 6px;
  transition: transform .15s, border-color .2s, background .2s;
}
.room-card:hover { transform: translateY(-3px); border-color: var(--accent); background: var(--panel-2); }
.room-icon { font-size: 30px; margin-bottom: 6px; }
.room-title { font-size: 18px; font-weight: 700; }
.room-desc { color: var(--muted); font-size: 14px; }
.room-join { margin-top: 10px; color: var(--accent); font-weight: 600; font-size: 14px; }

.custom-row { display: flex; gap: 12px; flex-wrap: wrap; }
.custom-row .input { flex: 1 1 220px; }

.features {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px; margin-top: 40px;
}
.feature {
  padding: 16px; border-radius: 14px; background: rgba(255, 255, 255, .02);
  border: 1px dashed var(--line); color: var(--muted); font-size: 14px;
}
.feature b { display: block; color: var(--text); font-size: 15px; margin-bottom: 2px; }

/* ---------- الغرفة ---------- */
.room {
  height: 100vh; height: 100dvh;
  display: grid; grid-template-rows: auto 1fr auto;
}
.room-header {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 14px 20px; border-bottom: 1px solid var(--line); background: rgba(13, 15, 20, .7);
  backdrop-filter: blur(10px);
}
.room-header .left { display: flex; align-items: center; gap: 12px; min-width: 0; }
.room-name { font-weight: 700; font-size: 18px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.status { font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
.dot.ok { background: var(--good); box-shadow: 0 0 8px var(--good); }
.dot.wait { background: var(--accent); animation: pulse 1.2s infinite; }
@keyframes pulse { 50% { opacity: .3; } }

.room-body { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }

/* المسرح (البث) */
.stage {
  position: relative; padding: 16px; min-height: 0; overflow: auto;
  display: grid; gap: 12px; align-content: center;
}
.stage.count-1 { grid-template-columns: 1fr; }
.stage.count-2 { grid-template-columns: repeat(2, 1fr); }
.stage.count-many { grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); }

.empty-stage { text-align: center; color: var(--muted); padding: 40px 16px; }
.empty-stage .big { font-size: 56px; margin-bottom: 8px; }
.empty-stage h3 { color: var(--text); font-size: 20px; margin-bottom: 4px; }

.tile {
  position: relative; background: #000; border-radius: var(--radius); overflow: hidden;
  border: 1px solid var(--line); aspect-ratio: 16 / 9;
}
.tile video { width: 100%; height: 100%; object-fit: contain; background: #000; display: block; }
.tile-label {
  position: absolute; bottom: 10px; right: 10px;
  background: rgba(0, 0, 0, .65); padding: 4px 12px; border-radius: 999px; font-size: 13px;
}
.tile-res {
  position: absolute; top: 10px; right: 10px;
  background: rgba(255, 138, 61, .9); color: var(--accent-ink);
  padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 700;
}
.tile-actions { position: absolute; top: 10px; left: 10px; display: flex; gap: 6px; opacity: 0; transition: opacity .2s; }
.tile:hover .tile-actions { opacity: 1; }
.tile-btn {
  width: 36px; height: 36px; border-radius: 10px; background: rgba(0, 0, 0, .65);
  display: grid; place-items: center; font-size: 16px;
}
.tile-btn:hover { background: rgba(0, 0, 0, .85); }

/* الشريط الجانبي */
.sidebar {
  border-inline-start: 1px solid var(--line); background: var(--bg-2);
  display: grid; grid-template-rows: auto 1fr auto; min-height: 0;
}
.members { padding: 16px; border-bottom: 1px solid var(--line); max-height: 40vh; overflow: auto; }
.members h4, .chat-head { font-size: 14px; color: var(--muted); margin-bottom: 10px; font-weight: 600; }
.member { display: flex; align-items: center; gap: 10px; padding: 6px 0; }
.avatar {
  width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center;
  font-weight: 700; font-size: 14px; flex-shrink: 0; color: #fff;
}
.member-name { flex: 1; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-tags { display: flex; gap: 6px; font-size: 13px; color: var(--muted); }
.tag-live { color: var(--accent); font-weight: 700; }

.chat { display: flex; flex-direction: column; min-height: 0; padding: 16px 16px 0; }
.messages { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-bottom: 12px; }
.msg { max-width: 88%; padding: 8px 12px; border-radius: 14px; background: var(--panel-2); align-self: flex-start; word-wrap: break-word; }
.msg.me { background: rgba(255, 138, 61, .18); align-self: flex-end; }
.msg .who { font-size: 12px; color: var(--accent-2); font-weight: 700; margin-bottom: 2px; }
.msg .time { font-size: 11px; color: var(--muted); margin-top: 2px; }
.msg.sys { align-self: center; background: none; color: var(--muted); font-size: 13px; padding: 2px; }

.chat-form { display: flex; gap: 8px; padding: 12px 16px 16px; border-top: 1px solid var(--line); }
.chat-form .input { padding: 10px 12px; }
.chat-form .btn { padding: 10px 14px; }

/* شريط التحكم */
.controls {
  display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
  padding: 14px 16px; border-top: 1px solid var(--line); background: rgba(13, 15, 20, .85);
}
.ctrl {
  display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px; border-radius: 14px;
  background: var(--panel-2); border: 1px solid var(--line); font-weight: 600;
  transition: background .2s, border-color .2s;
}
.ctrl:hover { background: #2a3145; }
.ctrl.off { background: rgba(255, 92, 108, .16); border-color: rgba(255, 92, 108, .4); color: var(--bad); }
.ctrl.live { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: var(--accent-ink); border-color: transparent; }
.quality { display: flex; gap: 6px; align-items: center; }

.toast {
  position: fixed; bottom: 96px; left: 50%; transform: translateX(-50%);
  background: var(--panel-2); border: 1px solid var(--line); padding: 10px 18px;
  border-radius: 12px; box-shadow: var(--shadow); z-index: 50; font-size: 14px;
  animation: up .25s ease;
}
@keyframes up { from { opacity: 0; transform: translate(-50%, 10px); } }

/* ---------- الجوال ---------- */
@media (max-width: 860px) {
  .room-body { grid-template-columns: 1fr; grid-template-rows: minmax(220px, 1fr) minmax(260px, 45vh); }
  .sidebar { border-inline-start: 0; border-top: 1px solid var(--line); }
  .members { max-height: 120px; }
  .stage.count-2, .stage.count-many { grid-template-columns: 1fr; }
  .ctrl .txt { display: none; }
  .tile-actions { opacity: 1; }
}